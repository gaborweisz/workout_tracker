<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. The Anthropic API key must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
